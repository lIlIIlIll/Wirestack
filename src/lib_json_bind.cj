package yjson

import std.ast.*
import std.collection.*
import std.io.*

// Public aliases used by caller-side macro expansion. They keep generated
// collection helpers independent of imports in the consuming source file.
public type YJsonArrayList<T> = ArrayList<T>
public type YJsonHashMap<K, V> = HashMap<K, V>

@Annotation
public class JsonName {
    public let value: String

    public const init(value: String) {
        this.value = value
    }
}

@Annotation
public class JsonIgnore {
    public const init() {}
}

@Annotation
public class JsonIncludeNull {
    public const init() {}
}

@Annotation
public class JsonProperty {
    public const init() {}
}

@Annotation
public class JsonAlias {
    public let value: String

    public const init(value: String) {
        this.value = value
    }
}

// Retained AST metadata emitted by @JsonUsing. Applications should use the
// macro rather than spelling this annotation directly.
@Annotation
public class JsonUsingMetadata {
    public let expression: String

    public const init(expression: String) {
        this.expression = expression
    }
}

// Retained AST metadata emitted by @JsonStatic. It is an explicit promise that
// the annotated field type is generated by @JsonCodec, allowing the generator
// to bind its package-level fast bridge without crossing JsonDirectCodec<T>.
@Annotation
public class JsonStaticMetadata {
    public const init() {}
}

@Annotation
public class JsonPolymorphic {
    public let discriminator: String

    public const init(discriminator!: String = "type") {
        this.discriminator = discriminator
    }
}

// Retained AST metadata emitted by @JsonSubtype. Each expression contains a
// wire discriminator followed by a concrete subtype, for example
// `@JsonSubtype["dog", Dog]`.
@Annotation
public class JsonSubtypeMetadata {
    public let expression: String

    public const init(expression: String) {
        this.expression = expression
    }
}

public interface JsonValueCodec<T> {
    func encode(value: T): JsonNode

    func decode(value: JsonNode): T
}

class LambdaJsonCodec<T> <: JsonValueCodec<T> {
    private let encoder: (T) -> JsonNode
    private let decoder: (JsonNode) -> T

    public init(encoder: (T) -> JsonNode, decoder: (JsonNode) -> T) {
        this.encoder = encoder
        this.decoder = decoder
    }

    public func encode(value: T): JsonNode {
        encoder(value)
    }

    public func decode(value: JsonNode): T {
        decoder(value)
    }
}

public class YJsonAst {
    public static func parse(text: String, config!: JsonReadConfig = JsonReadConfig.defaults): JsonNode {
        JsonNode.parse(text, config: config)
    }

    public static func parse(bytes: Array<Byte>, config!: JsonReadConfig = JsonReadConfig.defaults): JsonNode {
        JsonNode.parse(bytes, config: config)
    }

    public static func stringify(value: JsonNode, config!: JsonWriteConfig = JsonWriteConfig.compact): String {
        writeJsonValueToString(value, config)
    }

    public static func stringifyPretty(value: JsonNode, indent!: String = "  "): String {
        stringify(value, config: JsonWriteConfig(
            JsonWriteConfig.pretty.newline,
            indent,
            JsonWriteConfig.pretty.useSpaceAfterSeparators,
            JsonWriteConfig.pretty.htmlSafe
        ))
    }

    public static func encodeWith<T>(
        codec: JsonValueCodec<T>,
        value: T,
        config!: JsonCodecConfig = JsonCodecConfig.compact
    ): JsonNode {
        let _ = config
        codec.encode(value)
    }

    public static func decodeWith<T>(
        codec: JsonValueCodec<T>,
        value: JsonNode,
        config!: JsonCodecConfig = JsonCodecConfig.compact
    ): T {
        let _ = config
        codec.decode(value)
    }

    public static func encodeStringWith<T>(
        codec: JsonValueCodec<T>,
        value: T,
        config!: JsonWriteConfig = JsonWriteConfig.compact
    ): String {
        writeJsonValueToString(codec.encode(value), config)
    }

    public static func decodeStringWith<T>(
        codec: JsonValueCodec<T>,
        text: String,
        config!: JsonReadConfig = JsonReadConfig.defaults
    ): T {
        codec.decode(parse(text, config: config))
    }

    public static func encodeToStreamWith<T>(
        codec: JsonValueCodec<T>,
        value: T,
        out: OutputStream,
        config!: JsonWriteConfig = JsonWriteConfig.compact
    ): Unit {
        writeJsonValueToStream(codec.encode(value), out, config)
    }

    public static func decodeFromStreamWith<T>(
        codec: JsonValueCodec<T>,
        input: InputStream,
        config!: JsonReadConfig = JsonReadConfig.defaults
    ): T {
        codec.decode(parseJsonValueFromStream(input, config: config))
    }

    public static func optionCodec<T>(inner: JsonValueCodec<T>): JsonValueCodec<Option<T>> {
        LambdaJsonCodec<Option<T>>(
            { value =>
                match (value) {
                    case Some(item) => inner.encode(item)
                    case None => JsonNullValue()
                }
            },
            { value =>
                match (value) {
                    case _: JsonNullValue => None<T>
                    case other => Some(inner.decode(other))
                }
            }
        )
    }

    public static func arrayCodec<T>(inner: JsonValueCodec<T>): JsonValueCodec<Array<T>> {
        LambdaJsonCodec<Array<T>>(
            { value =>
                let items = ArrayList<JsonNode>(value.size)
                for (index in 0..value.size) {
                    items.add(inner.encode(value[index]))
                }
                JsonArrayValue(items)
            },
            { value =>
                let array = value.asArray()
                Array<T>(array.size(), {
                    index => inner.decode(array[index])
                })
            }
        )
    }

    public static func arrayListCodec<T>(inner: JsonValueCodec<T>): JsonValueCodec<ArrayList<T>> {
        LambdaJsonCodec<ArrayList<T>>(
            { value =>
                let items = ArrayList<JsonNode>(value.size)
                for (item in value) {
                    items.add(inner.encode(item))
                }
                JsonArrayValue(items)
            },
            { value =>
                let array = value.asArray()
                ArrayList<T>(array.size()) {
                    index => inner.decode(array[index])
                }
            }
        )
    }

    public static func hashMapCodec<T>(valueCodec: JsonValueCodec<T>): JsonValueCodec<HashMap<String, T>> {
        LambdaJsonCodec<HashMap<String, T>>(
            { value =>
                let fields = HashMap<String, JsonNode>(value.size)
                for ((key, item) in value) {
                    fields.add(key, valueCodec.encode(item))
                }
                JsonObjectValue(fields)
            },
            { value =>
                let object = value.asObject()
                let result = HashMap<String, T>(object.size())
                for ((key, item) in object.entries()) {
                    result.add(key, valueCodec.decode(item))
                }
                result
            }
        )
    }
}
