        for ((wire, expected) in corpus) {
            let source = GzipFixtureSource(gzipHex(wire), chunk: 3)
            let body = GzipBodyStream(source, limits: GzipLimits(maximumEncodedBytes: 1024,
                maximumDecodedBytes: 1024, maximumHeaderBytes: 128, maximumBlocks: 32,
                inputBufferBytes: 11, maximumReadBytes: 13))
            if (expected == "!") {
                let _ = @AssertThrows[GzipException](gzipDrain(body))
                @Expect(source.isClosed())
                @Expect(body.isClosed())
                @Expect(!body.integrityVerified)
            } else {
                let decoded = gzipDrain(body); let oracle = gzipHex(expected)
                @Assert(decoded.size, oracle.size)
                for (index in 0..decoded.size) { @Assert(decoded[index], oracle[index]) }
                @Expect(body.integrityVerified)
                @Expect(source.isClosed())
            }
            @Expect(body.decodedBytes <= 1024)
            @Expect(body.maximumWorkBetweenChecks > 0 && body.maximumWorkBetweenChecks <= 512)
        }
