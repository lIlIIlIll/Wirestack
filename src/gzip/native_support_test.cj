package wirestack.gzip

import std.collection.ArrayList

// Independent self-signed example.com test identity, valid October 2026 to October 2036.
internal func gzipNativeCertificate(): Array<Byte> { gzipNativeBase64("") }
internal func gzipNativePrivateKey(): Array<Byte> { gzipNativeBase64("") }

// Python gzip.compress, mtime=0: one MiB of ASCII a, and the text hello gzip.
internal func gzipNativeLargeMember(): Array<Byte> { gzipNativeBase64("") }
internal func gzipNativeSmallMember(): Array<Byte> { gzipNativeBase64("H4sIAAAAAAAC/8tIzcnJV0ivyiwAABlq0t8KAAAA") }

// Three RFC1951 stored blocks; CRC32 of 131072 ASCII a bytes is ca975130.
internal func gzipNativeWideMember(): Array<Byte> {
    let bytes = ArrayList<Byte>()
    for (byte in [31u8, 139u8, 8u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 255u8]) { bytes.add(byte) }
    for (count in [65535, 65535, 2]) {
        bytes.add(if (count == 2) { 1u8 } else { 0u8 })
        bytes.add(UInt8(count & 255)); bytes.add(UInt8(count >> 8))
        let inverted = 65535 - count
        bytes.add(UInt8(inverted & 255)); bytes.add(UInt8(inverted >> 8))
        for (_ in 0..count) { bytes.add(b'a') }
    }
    for (byte in [48u8, 81u8, 151u8, 202u8, 0u8, 0u8, 2u8, 0u8]) { bytes.add(byte) }
    bytes.toArray()
}
private func gzipNativeBase64(value: String): Array<Byte> {
    let output = ArrayList<Byte>()
    var accumulator: Int64 = 0
    var bits: Int64 = 0
    for (byte in value.toArray()) {
        if (byte == b'=') { break }
        let decoded: Int64 = if (byte >= b'A' && byte <= b'Z') { Int64(byte - b'A') }
        else if (byte >= b'a' && byte <= b'z') { Int64(byte - b'a') + 26 }
        else if (byte >= b'0' && byte <= b'9') { Int64(byte - b'0') + 52 }
        else if (byte == b'+') { 62 } else if (byte == b'/') { 63 }
        else { throw IllegalArgumentException("invalid public gzip test fixture") }
        accumulator = (accumulator << 6) | decoded
        bits += 6
        if (bits >= 8) {
            bits -= 8
            output.add(UInt8(UInt64((accumulator >> bits) & 0xff)))
            accumulator &= if (bits == 0) { 0 } else { (1 << bits) - 1 }
        }
    }
    output.toArray()
}
