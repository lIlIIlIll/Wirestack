+    r"|\bopenssl(?:\.exe)?\s+(?:sha256|sha-256)\b"
+    r"|\bcksum\b[^\r\n]*(?:-a\s+sha256|--algorithm(?:=|\s+)sha256)\b"
+    r"|\bhashlib\s*\.\s*(?:sha256|new\s*\([^\r\n]*sha256)"
