+        "\"tls_negotiated\":true,\"h2_negotiated\":${h2},\"maximum_outstanding_messages\":${fixture.outstandingHigh.load()},\"consumer_pause_ns\":${if (slow) { 1000000 } else { 0 }}," +
+        "\"${if (isSse) { "first_event_ns" } else { "first_message_ns" }}\":${first}"
