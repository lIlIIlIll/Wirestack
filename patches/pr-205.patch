+@Test
+class GzipClientHeaderLimitsTest {
+    @TestCase
+    func wrappedClientExposesItsConfiguredHeaderLimits(): Unit {
+        let limits = HttpLimits(maxHeaderCount: 300, maxHeaderBytes: 1000000)
+        let client = HttpClient.builder().limits(limits).build()
+        try {
+            @Expect(client.configuredLimits().maxHeaderCount, 300)
+            @Expect(client.configuredLimits().maxHeaderBytes, 1000000)
+        } finally {
+            client.close()
+        }
+    }
+    @TestCase
+    func gzipRequestRebuildAcceptsHeadersValidUnderConfiguredLimits(): Unit {
+        let larger = HttpLimits(maxHeaderCount: 300, maxHeaderBytes: 1000000)
+        let rebuilt = requestWithGzipAcceptEncoding(gzipRequestWithManyHeaders(larger), larger)
+        @Expect(rebuilt.headers.contains("accept-encoding"))
+        @Expect(rebuilt.headers.getAll("gzip-review-0").size, 1)
+        @Expect(rebuilt.headers.getAll("gzip-review-149").size, 1)
+    }
+    @TestCase
+    func gzipRequestRebuildStillRejectsHeadersBeyondTheSuppliedLimits(): Unit {
+        let larger = HttpLimits(maxHeaderCount: 300, maxHeaderBytes: 1000000)
+        let request = gzipRequestWithManyHeaders(larger)
+        var rejected = false
+        try {
+            let _ = requestWithGzipAcceptEncoding(request, HttpLimits())
+        } catch (_: IllegalArgumentException) {
+            rejected = true
+        }
+        @Expect(rejected)
+    }
+    @TestCase
+    func decodedResponseViewAcceptsHeadersValidUnderConfiguredLimits(): Unit {
+        let larger = HttpLimits(maxHeaderCount: 300, maxHeaderBytes: 1000000)
+        let decoded = decodedGzipResponseHeaders(gzipResponseWithManyHeaders(larger), larger)
+        @Expect(decoded.getAll("content-encoding").size, 0)
+        @Expect(decoded.getAll("content-length").size, 0)
+        @Expect(decoded.getAll("gzip-review-0").size, 1)
+        @Expect(decoded.getAll("gzip-review-149").size, 1)
+    }
+    @TestCase
+    func decodedResponseViewStillRejectsHeadersBeyondTheSuppliedLimits(): Unit {
+        let larger = HttpLimits(maxHeaderCount: 300, maxHeaderBytes: 1000000)
+        let raw = gzipResponseWithManyHeaders(larger)
+        var rejected = false
+        try {
+            let _ = decodedGzipResponseHeaders(raw, HttpLimits())
+        } catch (_: IllegalArgumentException) {
+            rejected = true
+        }
+        @Expect(rejected)
+    }
+}
