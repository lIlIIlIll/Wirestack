+@Test
+class GzipRedirectLeaseOwnerTest {
+    @TestCase
+    func sameOwnerRedirectRetainsTheDecoderLease(): Unit {
+        let client = HttpClient.default()
+        try {
+            let original = HttpUrl.parse("https://origin.example/start?step=1")
+            @Expect(client.sameResponseBufferOwner(original,
+                HttpUrl.parse("https://origin.example/next/path?step=2")))
+            @Expect(client.sameResponseBufferOwner(
+                HttpUrl.parse("https://origin.example:443/start"),
+                HttpUrl.parse("https://origin.example/next")))
+        } finally {
+            client.close()
+        }
+    }
+    @TestCase
+    func ownerChangeRequiresTheDecoderLeaseToMove(): Unit {
+        let client = HttpClient.default()
+        try {
+            let original = HttpUrl.parse("https://origin.example/start")
+            @Expect(!client.sameResponseBufferOwner(original,
+                HttpUrl.parse("https://other.example/next")))
+            @Expect(!client.sameResponseBufferOwner(original,
+                HttpUrl.parse("http://origin.example/next")))
+            @Expect(!client.sameResponseBufferOwner(original,
+                HttpUrl.parse("https://origin.example:8443/next")))
+        } finally {
+            client.close()
+        }
+    }
+}
