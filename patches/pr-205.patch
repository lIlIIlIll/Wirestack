+private func gzipRequestWithManyHeaders(limits: HttpLimits): HttpRequest {
+    let builder = HttpHeaders.builder(limits: limits)
+    for (index in 0..150) {
+        builder.add("gzip-review-${index}", "value")
+    }
+    HttpRequest.get("http://example.test/").withHeaders(builder.build())
+}
+
+private func gzipResponseWithManyHeaders(limits: HttpLimits): HttpHeaders {
+    let builder = HttpHeaders.builder(limits: limits)
+    for (index in 0..150) {
+        builder.add("gzip-review-${index}", "value")
+    }
+    builder.add("Content-Encoding", "gzip")
+    builder.add("Content-Length", "1234")
+    builder.build()
+}
