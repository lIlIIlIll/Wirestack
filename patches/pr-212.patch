+        "evaluation_environment": {
+            "system": platform.system(),
+            "machine": platform.machine(),
+            "libc": list(platform.libc_ver()),
+        },
+        "artifacts": artifacts,
+        "domains": domains,
+        "failed_domains": [domain["name"] for domain in domains if domain["decision"] != "PASS"],
+    }
