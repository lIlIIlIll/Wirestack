+def failure_report(manifest_path: Path, reason: str) -> dict[str, Any]:
+    return {
+        "schema_version": 1,
+        "gate_id": "M7-024-LINUX-PERFORMANCE",
+        "profile": "linux-glibc-x86_64",
+        "decision": "FAIL",
+        "generated_at_utc": utc_now(),
+        "manifest": str(manifest_path),
+        "gate_errors": [reason],
