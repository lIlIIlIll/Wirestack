+private func isPoolLifecycleEvent(event: NetworkEvent): Bool {
+    match (event.kind) {
+        case NetworkEventKind.HttpConnectionAcquired => true
+        case NetworkEventKind.HttpConnectionReleased => true
+        case NetworkEventKind.ConnectionClosed => true
+        case _ => false
+    }
+}
