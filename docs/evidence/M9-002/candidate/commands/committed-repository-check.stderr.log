    | | /* 156.350 */        let serving: Future < Array < String >>= spawn { let names = ArrayList < String >()
    | | /* 156.351 */            for(_ in 0 .. 3) {
    | | /* 156.352 */                let received = server.receive(512, context: api.OperationContext(deadline: Some(api.Deadline.after(2 * Duration.second))))
    | | /* 156.353 */                names.add(DnsMessageParser().parse(received.payload).questions[0].name)
    | | /* 156.354 */                let header = received.payload.clone()
    | | /* 156.355 */                header[2] = 0x81u8
    | | /* 156.356 */                header[3] = 0x80u8
    | | /* 156.357 */                header[7] = 1u8
    | | /* 156.358 */                let response = ArrayList < Byte >()
    | | /* 156.359 */                for(byte in header) {
    | | /* 156.360 */                    response.add(byte)
    | | /* 156.361 */                }
    | | /* 156.362 */                for(byte in[0xC0u8, 0x0Cu8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 4u8, 127u8, 0u8, 0u8, 42u8]) {
    | | /* 156.363 */                    response.add(byte)
    | | /* 156.364 */                }
    | | /* 156.365 */                let _ = server.sendTo(received.source.getOrThrow(), api.ByteSpan(response.toArray()), context: api.OperationContext(deadline: Some(api.Deadline.after(Duration.second))))
    | | /* 156.366 */            }
    | | /* 156.367 */            names.toArray()
    | | /* 156.368 */        }
    | | /* 156.369 */        let options = api.ResolveOptions(family: api.ResolveAddressFamily.Ipv4)
    | | /* 156.370 */        try {
    | | /* 156.371 */            let expanded = searchFirst.resolve("service", options: options)
    | | /* 156.372 */            expectEqual("expanded.canonicalHost", "api.HostName(\"service.search.test\")", expanded.canonicalHost, api.HostName("service.search.test"), isDelta: false)
    | | /* 156.373 */            let rooted = searchFirst.resolve("service.", options: options)
