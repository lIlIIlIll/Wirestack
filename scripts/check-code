#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python3 tools/architecture_guard.py --root . --format text
scripts/build-linux-resolver --quiet

# Documentation is a release-facing gate. It is deliberately short-running;
# long profiles are owned by their task manifests and are never reached here.
# Keep the clean-tree gate's diagnostic report in ignored build/ state; the
# canonical evidence report is generated by the dedicated documentation job.
scripts/check-docs --json --output build/check-docs.json

command -v cjc >/dev/null
command -v cjpm >/dev/null
cjpm check
cjpm build
cjpm test --exclude-tags=Performance --parallel 1 --no-progress --no-color
