#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python3 -m unittest discover -s tools/tests -p 'test_*.py' -v
python3 -m unittest discover -s tools/gates/tests -p 'test_*.py' -v
if [[ -d tools/benchmarks/tests ]]; then
  python3 -m unittest discover -s tools/benchmarks/tests -p 'test_*.py' -v
fi
scripts/check-code
