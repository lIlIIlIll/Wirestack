#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -lt 1 ]]; then echo "usage: scripts/verify-evidence <TASK-ID>|--all [--json] [--output PATH]" >&2; exit 2; fi
if [[ "$1" == "--all" ]]; then shift; exec python3 "$repo_root/tools/repository/repository_tooling.py" --root "$repo_root" verify-evidence --all "$@"; fi
task_id="$1"; shift
exec python3 "$repo_root/tools/repository/repository_tooling.py" --root "$repo_root" verify-evidence --task "$task_id" "$@"
