{
  "schema_version": 1,
  "gate_id": "GATE-HTTP1-QUALITY",
  "description": "Linux HTTP/1 conformance and deterministic mutation fuzz evidence",
  "scenarios": [
    {
      "id": "linux-http1-conformance",
      "platforms": ["linux"],
      "required_tools": ["python3", "cjc", "cjpm"],
      "timeout_seconds": 600,
      "steps": [
        {
          "id": "run-conformance",
          "command": ["python3", "tools/gates/http1_quality.py", "--suite", "conformance", "--output", "{artifact_dir}/http1-conformance.json"]
        }
      ]
    },
    {
      "id": "linux-http1-fuzz",
      "platforms": ["linux"],
      "required_tools": ["python3", "cjc", "cjpm"],
      "timeout_seconds": 600,
      "steps": [
        {
          "id": "run-fuzz",
          "command": ["python3", "tools/gates/http1_quality.py", "--suite", "fuzz", "--output", "{artifact_dir}/http1-fuzz.json"]
        }
      ]
    }
  ]
}
