  "acceptance_commands": [
    {
      "id": "architecture-guard",
      "argv": [
        "python3",
        "tools/architecture_guard.py",
        "--root",
        ".",
        "--format",
        "text"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "fast"
    },
    {
      "id": "current-public-api",
      "argv": [
        "scripts/check-m7-032-public-api",
        "--json"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "fast"
    },
    {
      "id": "cjpm-check",
      "argv": [
        "cjpm",
        "check"
      ],
      "timeout_seconds": 300,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "native-sse-and-regression",
      "argv": [
        "cjpm",
        "test",
        "--target-dir",
        "target/m11-001-native",
        "--exclude-tags=Performance",
        "--parallel",
        "1",
        "--no-progress",
        "--no-color",
        "--timeout-each",
        "60s"
      ],
      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "api-validator-behavior",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tools.tests.test_m7_026_linux_api_freeze",
        "tools.tests.test_m7_032_public_api_contract"
      ],
      "timeout_seconds": 120,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "installed-sse",
      "argv": [
        "python3",
        "tools/m11_001_native_sse.py"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "public-documentation",
      "argv": [
        "env",
        "cjHeapSize=1GB",
        "scripts/check-docs",
        "--html",
        "--json",
        "--output",
        "docs/evidence/M11-001/docs-report.json"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "one-hour-production-sse",
      "argv": [
        "python3",
        "tools/gates/m11_001_sse_streaming_profile.py",
        "--target-dir",
        "target/m11-001-streaming",
        "--output",
        "docs/evidence/M11-001/streaming/report.json",
        "--duration-seconds",
        "3600",
        "--minimum-events",
        "1000000"
      ],
      "timeout_seconds": 5400,
      "long_running": true,
      "gate": "long"
    }
  ],
  "required_evidence": [
