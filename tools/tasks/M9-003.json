  "acceptance_commands": [
    {
      "id": "udp-plan",
      "argv": [
        "python3",
        "tools/repository/repository_tooling.py",
        "--root",
        ".",
        "validate-plan",
        "docs/evidence/M9-003/test-plan.md",
        "--json"
      ],
      "gate": "task",
      "long_running": false,
      "timeout_seconds": 30
    },
    {
      "id": "udp-regressions",
      "argv": [
        "cjpm",
        "test",
        "src/net",
        "src/internal/transport_stdnet",
        "--filter=M9003*.*",
        "--no-progress",
        "--no-color"
      ],
      "gate": "task",
      "long_running": false,
      "timeout_seconds": 180
    },
    {
      "id": "capability-negative-regressions",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tools.tests.test_network_capabilities",
        "tools.tests.test_m9_001_native_capabilities",
        "tools.tests.test_m9_003_api_compatibility",
        "-v"
      ],
      "gate": "task",
      "long_running": false,
      "timeout_seconds": 120
    },
    {
      "id": "installed-native-udp",
      "argv": [
        "python3",
        "tools/m9_003_native_udp.py",
        "--offline"
      ],
      "gate": "long",
      "long_running": true,
      "timeout_seconds": 1800
    },
    {
      "id": "capability-correspondence",
      "argv": [
        "python3",
        "tools/check_network_capabilities.py",
        "--check",
        "--require-native",
        "--native-report",
        "docs/evidence/M9-003/native-udp.json",
        "--report",
        "docs/evidence/M9-003/capabilities.json",
        "--api-report",
        "docs/evidence/M9-003/api-inventory.json"
      ],
      "gate": "task",
      "long_running": false,
      "timeout_seconds": 60
    },
    {
      "id": "api-compatibility",
      "argv": [
        "python3",
        "tools/m9_003_api_compatibility.py"
      ],
      "gate": "task",
      "long_running": false,
      "timeout_seconds": 60
    },
    {
      "id": "repository-check",
      "argv": [
        "scripts/check"
      ],
      "gate": "long",
      "long_running": true,
      "timeout_seconds": 1800
    },
    {
      "id": "public-api-html",
      "argv": [
        "scripts/check-docs",
        "--html",
        "--json",
        "--output",
        "docs/evidence/M9-003/docs-report.json"
      ],
      "gate": "long",
      "long_running": true,
      "timeout_seconds": 900
    }
  ],
