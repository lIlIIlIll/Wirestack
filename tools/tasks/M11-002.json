        "tools.tests.test_m7_026_linux_api_freeze",
        "tools.tests.test_m7_032_public_api_contract"
      ],
      "timeout_seconds": 120,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "installed-raw-and-gzip",
      "argv": [
        "python3",
        "tools/m11_002_native_gzip.py"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "strict-seven-package-docs",
      "argv": [
        "scripts/check-docs",
        "--html",
        "--output",
        "docs/evidence/M11-002/docs/report.json"
      ],
      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    }
  ],
