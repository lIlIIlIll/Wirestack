        "check"
      ],
      "timeout_seconds": 300,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "native-gzip-and-regression",
      "argv": [
        "cjpm",
        "test",
        "--target-dir",
        "target/m11-002-native",
        "--exclude-tags=Performance",
        "--parallel",
