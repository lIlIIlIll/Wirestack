  "acceptance_commands": [
    {
      "id": "plan-validation",
      "argv": [
        "python3",
        "tools/repository/repository_tooling.py",
        "--root",
        ".",
        "validate-plan",
        "docs/evidence/M8-003/test-plan.md",
        "--json"
      ],
      "timeout_seconds": 30,
      "long_running": false,
      "gate": "fast"
    },
    {
      "id": "architecture-guard",
      "argv": [
        "python3",
        "tools/architecture_guard.py",
        "--format",
        "json"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "fast"
    },
    {
      "id": "task-contract-validation",
      "argv": [
        "python3",
        "tools/repository/repository_tooling.py",
        "--root",
        ".",
        "validate-tasks",
        "--json"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "fast"
    },
    {
      "id": "cangjie-check",
      "argv": [
        "cjpm",
        "check"
      ],
      "timeout_seconds": 120,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "cangjie-build",
      "argv": [
        "cjpm",
        "build"
      ],
      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "network-contract-tests",
      "argv": [
        "cjpm",
        "test",
        "src/net",
        "--no-progress",
        "--no-color"
      ],
      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "transport-regression-tests",
      "argv": [
        "cjpm",
        "test",
        "src/internal/transport_stdnet",
        "--exclude-tags=Performance",
        "--parallel",
        "1",
        "--no-progress",
        "--no-color"
      ],
      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "native-socket-consumer",
      "argv": [
        "python3",
        "tools/m8_003_native_sockets.py",
        "--report",
        "docs/evidence/M8-003/native-sockets.json"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "public-api-inventory",
      "argv": [
        "python3",
        "tools/m7_026_linux_api_freeze.py",
        "--baseline",
        "docs/api/baselines/wirestack-linux-pre1-m8-003.json",
        "--report",
        "docs/evidence/M8-003/api-inventory.json"
      ],
      "timeout_seconds": 120,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "public-api-documentation",
      "argv": [
        "scripts/check-docs",
        "--json",
        "--output",
        "docs/evidence/M8-003/docs-report.json"
      ],
      "timeout_seconds": 1800,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "repository-full-check",
      "argv": [
        "scripts/check"
      ],
      "timeout_seconds": 3600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "repository-regression-tests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tools.repository.tests.test_repository_tooling",
        "tools.tests.test_architecture_guard",
        "tools.tests.test_m7_026_linux_api_freeze",
        "tools.tests.test_m7_033_docs",
        "tools.tests.test_m7_linux_task_graph",
        "-v"
      ],
      "timeout_seconds": 300,
      "long_running": false,
      "gate": "task"
    }
  ],
