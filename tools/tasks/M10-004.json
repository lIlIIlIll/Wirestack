      "timeout_seconds": 600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "repository-check",
      "argv": [
        "scripts/check"
      ],
      "timeout_seconds": 1800,
      "long_running": false,
      "gate": "full"
