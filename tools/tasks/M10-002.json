  "acceptance_commands": [
    {
      "id": "architecture-guard",
      "argv": [
        "python3",
        "tools/architecture_guard.py",
        "--root",
        ".",
        "--format",
        "text"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "network-capability-contract",
      "argv": [
        "python3",
        "tools/check_network_capabilities.py",
        "--check"
      ],
      "timeout_seconds": 60,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "cjpm-check",
      "argv": [
        "cjpm",
        "check"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "cjpm-build",
      "argv": [
        "cjpm",
        "build"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "full-native-regression",
      "argv": [
        "cjpm",
        "test",
        "--exclude-tags=Performance",
        "--parallel",
        "1",
        "--no-progress",
        "--no-color"
      ],
      "timeout_seconds": 3600,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "resource-profile-nofile-64",
      "argv": [
        "bash",
        "-c",
        "ulimit -n 64 && cjpm test --skip-build --exclude-tags=Performance --parallel 1 --no-progress --no-color src/internal/http2"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "resource-profile-data-1g",
      "argv": [
        "bash",
        "-c",
        "ulimit -d 1048576 && cjpm test --skip-build --exclude-tags=Performance --parallel 1 --no-progress --no-color src/internal/http2"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "resource-profile-as-4g",
      "argv": [
        "bash",
        "-c",
        "ulimit -v 4194304 && cjpm test --skip-build --exclude-tags=Performance --parallel 1 --no-progress --no-color src/internal/http2"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "resource-profile-single-cpu",
      "argv": [
        "taskset",
        "-c",
        "0",
        "cjpm",
        "test",
        "--skip-build",
        "--exclude-tags=Performance",
        "--parallel",
        "1",
        "--no-progress",
        "--no-color",
        "src/internal/http2"
      ],
      "timeout_seconds": 900,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "documentation-check",
      "argv": [
        "env",
        "cjHeapSize=1GB",
        "scripts/check-docs",
        "--json",
        "--output",
        "docs/evidence/M10-002/stack-200-review/docs-report.json"
      ],
      "timeout_seconds": 1800,
      "long_running": false,
      "gate": "task"
    },
    {
      "id": "repository-check",
      "argv": [
        "scripts/check"
      ],
      "timeout_seconds": 7200,
      "long_running": false,
      "gate": "full"
    }
  ],
  "required_evidence": [
    "docs/evidence/M10-002/stack-200-review/scenario-matrix.json",
    "docs/evidence/M10-002/stack-200-review/verification.json"
